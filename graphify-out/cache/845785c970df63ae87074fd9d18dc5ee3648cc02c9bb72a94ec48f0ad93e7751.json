backend/src/users/users.service.ts","source_location":"L59"}],"snippet":"async create(createUserDto: CreateUserDto): Promise<User> {\n    // Check if email already exists\n    const existingUser = await this.usersRepository.findByEmail(\n      createUserDto.email,\n    );\n    if (existingUser) {\n      throw new ConflictException(\n        `User with email ${createUserDto.email} already exists`,\n      );\n    }\n\n    // Generar ID si no se proporcionó\n    const userId = createUserDto.id || this.generateUUID();\n\n    const newUser: Partial<User> & { id: string } = {\n      ...createUserDto,\n      id: userId,\n      password: null,\n    };\n\n    if (createUserDto.password) {\n      newUser.password = await bcrypt.hash(\n        createUserDto.password,\n        BCRYPT_SALT_ROUNDS,\n      );"},{"id":"users_service_usersservice_update","label":".update()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L95-L129","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L95"}],"snippet":"async update(id: string, updateUserDto: UpdateUserDto): Promise<User> {\n    const user = await this.usersRepository.findById(id);\n    if (!user) {\n      throw new NotFoundException(`User with ID ${id} not found`);\n    }\n\n    // Update allowed fields\n    const allowedFields = [\n      'nombre',\n      'apellidos',\n      'telefono',\n      'rol',\n      'avatar',\n      'activo',\n    ];\n    const updateData: Partial<User> = {};\n\n    for (const field of allowedFields) {\n      if ((updateUserDto as Record<string, unknown>)[field] !== undefined) {\n        (updateData as Record<string, unknown>)[field] = (\n          updateUserDto as Record<string, unknown>\n        )[field];\n      }\n    }"},{"id":"users_service_usersservice_softdelete","label":".softDelete()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L132-L138","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L132"}],"snippet":"async softDelete(id: string): Promise<void> {\n    const user = await this.usersRepository.findById(id);\n    if (!user) {\n      throw new NotFoundException(`User with ID ${id} not found`);\n    }\n    await this.usersRepository.softDelete(id);\n  }"},{"id":"users_service_usersservice_restore","label":".restore()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L141-L148","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L141"}],"snippet":"async restore(id: string): Promise<User> {\n    const user = await this.usersRepository.findById(id);\n    if (!user) {\n      throw new NotFoundException(`User with ID ${id} not found`);\n    }\n    await this.usersRepository.restore(id);\n    return this.findOne(id);\n  }"},{"id":"users_service_usersservice_remove","label":".remove()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L150-L156","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/users/users.service.ts","source_location":"L150"}],"snippet":"async remove(id: string): Promise<void> {\n    const user = await this.usersRepository.findById(id);\n    if (!user) {\n      throw new NotFoundException(`User with ID ${id} not found`);\n    }\n    await this.usersRepository.softDelete(id