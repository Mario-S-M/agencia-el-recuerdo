:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/hoteles/data/repositories/hotel.repository.ts","source_location":"L43"}],"snippet":"function toResumenDomain(dto: HotelResumenDTO): HotelResumen {\n  return { id: dto.id, nombre: dto.nombre };\n}"},{"id":"hotel_repository_hotelrepository","label":"HotelRepository","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/hoteles/data/repositories/hotel.repository.ts","source_location":"L47-L146","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/hoteles/data/repositories/hotel.repository.ts","source_location":"L47"}],"snippet":"export class HotelRepository implements IHotelRepository {\n  async findAll(): Promise<Hotel[]> {\n    const dtos = await hotelApi.findAll();\n    return dtos.map(toHotelDomain);\n  }\n\n  async findAllActive(): Promise<HotelResumen[]> {\n    const dtos = await hotelApi.findAllActive();\n    return dtos.map(toResumenDomain);\n  }\n\n  async findOne(id: string): Promise<Hotel> {\n    const dto = await hotelApi.findOne(id);\n    return toHotelDomain(dto);\n  }\n\n  async create(input: CreateHotelDTO): Promise<Hotel> {\n    const dto = await hotelApi.create(input);\n    return toHotelDomain(dto);\n  }\n\n  async update(id: string, input: UpdateHotelDTO): Promise<Hotel> {\n    const dto = await hotelApi.update(id, input);\n    return toHotelDomain(dto);\n  }"},{"id":"hotel_repository_ihotelrepository","label":"IHotelRepository","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/hoteles/data/repositories/hotel.repository.ts","source_location":"L47","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/hoteles/data/repositories/hotel.repository.