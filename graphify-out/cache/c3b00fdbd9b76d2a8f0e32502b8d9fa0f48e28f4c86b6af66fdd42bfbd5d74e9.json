onales: dto.transportesAdicionales.map(toTransporte),\n    createdAt: dto.createdAt,\n    updatedAt: dto.updatedAt,\n  };\n}"},{"id":"fechas_salida_repository_tocreatedto","label":"toCreateDTO()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/data/repositories/fechas-salida.repository.ts","source_location":"L59-L71","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/data/repositories/fechas-salida.repository.ts","source_location":"L59"}],"snippet":"function toCreateDTO(input: CreateFechaSalidaInput): CreateFechaSalidaDTO {\n  return {\n    paqueteId: input.paqueteId,\n    fechaSalida: input.fechaSalida,\n    fechaRegreso: input.fechaRegreso,\n    cupoMaximo: input.cupoMaximo,\n    cupoMinimo: input.cupoMinimo,\n    cupoDisponible: input.cupoDisponible,\n    activo: input.activo,\n    opcionesHotel: input.opcionesHotel,\n    transportesAdicionales: input.transportesAdicionales,\n  };\n}"},{"id":"fechas_salida_repository_findaddeditem","label":"findAddedItem()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/data/repositories/fechas-salida.repository.ts","source_location":"L73-L80","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/data/repositories/fechas-salida.repository.ts","source_location":"L73"}],"snippet":"function findAddedItem<T extends { id: string }>(\n  items: T[],\n  filterFn: (item: T) => boolean,\n): T {\n  const found = items.find(filterFn);\n  if (!found) throw new Error('Error al obtener el elemento creado');\n  return found;\n}"},{"id":"fechas_salida_repository_fechassalidarepository","label":"FechasSalidaRepository","file_type":"code","source_file":"/Users/mario-e-s-m/Documen