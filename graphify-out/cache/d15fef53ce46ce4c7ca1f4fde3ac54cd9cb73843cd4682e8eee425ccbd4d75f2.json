in');\n    } catch (err) {\n      setError(err instanceof Error ? err.message : 'Error al iniciar sesión');\n    } finally {\n      setIsLoading(false);\n    }\n  }\n\n  return { isLoading, error, submit };\n}","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"uselogin_uselogin_submit","label":"submit()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/auth/presentation/hooks/useLogin.ts","source_location":"L23-L36","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/auth/presentation/hooks/useLogin.ts","source_location":"L23"}],"snippet":"async function submit(data: LoginFormData): Promise<void> {\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const response = await authRepository.login(data);\n      setAuth(response.access_token, response.user);\n      router.push('/admin');\n    } catch (err) {\n      setError(err instanceof Error ? err.message : 'Error al iniciar sesión');\n    } finally {\n      setIsLoading(false);\n    }\n  }"}],"edges":[{"source":"uselogin","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/auth/presentation/hooks/useLogin.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/auth/presentation/hooks/useLogin.ts","source_location":"L3"}],"weight":1},{"source":"uselogin","target":"navigation","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/auth/presentation/hooks/useLogin.ts","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source