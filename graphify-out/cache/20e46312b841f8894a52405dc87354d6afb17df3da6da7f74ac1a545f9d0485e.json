res/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L53"}],"snippet":"export function AdminFechasSalidaPage(): React.ReactElement {\n  const router = useRouter();\n  const { fechas, paquetes, isLoading, error, create, update, remove } = useFechasSalida();\n\n  const [modal, setModal] = useState<ModalState | null>(null);\n  const [deleteTarget, setDeleteTarget] = useState<FechaSalidaAdmin | null>(null);\n  const [submitting, setSubmitting] = useState(false);\n  const [formError, setFormError] = useState<string | null>(null);\n\n  function openCreate(): void {\n    setModal({ mode: 'create', fecha: null });\n    setFormError(null);\n  }\n\n  function openEdit(fecha: FechaSalidaAdmin): void {\n    setModal({ mode: 'edit', fecha });\n    setFormError(null);\n  }\n\n  function closeModal(): void {\n    setModal(null);\n    setFormError(null);\n  }\n\n  async function handleSubmit(data: FechaSalidaFormData): Promise<void> {","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"adminfechassalidapage_adminfechassalidapage_opencreate","label":"openCreate()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L62-L65","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L62"}],"snippet":"function openCreate(): void {\n    setModal({ mode: 'create', fecha: null });\n    setFormError(null);\n  }"},{"id":"adminfechassalidapage_adminfechassalidapage_openedit","label":"openEdit()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L67-L70","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L67"}],"snippet":"function openEdit(fecha: FechaSalidaAdmin): void {\n    setModal({ mode: 'edit', fecha });\n    setFormError(null);\n  }"},{"id":"adminfechassalidapage_adminfechassalidapage_closemodal","label":"closeModal()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L72-L75","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L72"}],"snippet":"function closeModal(): void {\n    setModal(null);\n    setFormError(null);\n  }"},{"id":"adminfechassalidapage_adminfechassalidapage_handlesubmit","label":"handleSubmit()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L77-L100","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L77"}],"snippet":"async function handleSubmit(data: FechaSalidaFormData): Promise<void> {\n    setSubmitting(true);\n    setFormError(null);\n    try {\n      const payload: UpdateFechaSalidaInput = {\n        fechaSalida: data.fechaSalida,\n        fechaRegreso: data.fechaRegreso || undefined,\n        cupoMaximo: Number(data.cupoMaximo),\n        cupoMinimo: Number(data.cupoMinimo),\n        cupoDisponible: Number(data.cupoDisponible),\n        activo: data.activo,\n      };\n      if (modal?.mode === 'edit' && modal.fecha) {\n        await update(modal.fecha.id, payload);\n      } else {\n        await create({ ...payload, paqueteId: data.paqueteId } as CreateFechaSalidaInput);\n      }\n      closeModal();\n    } catch (e) {\n      setFormError(e instanceof Error ? e.message : 'Error al guardar');\n    } finally {\n      setSubmitting(false);\n    }\n  }"},{"id":"adminfechassalidapage_adminfechassalidapage_handledelete","label":"handleDelete()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L102-L114","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L102"}],"snippet":"async function handleDelete(): Promise<void> {\n    if (!deleteTarget) return;\n    setSubmitting(true);\n    setFormError(null);\n    try {\n      await remove(deleteTarget.id);\n      setDeleteTarget(null);\n    } catch (e) {\n      setFormError(e instanceof Error ? e.message : 'Error al eliminar');\n    } finally {\n      setSubmitting(false);\n    }\n  }"}],"edges":[{"source":"adminfechassalidapage","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/components/client/AdminFechasSalidaPage.tsx","source_location":"L3"}],"weight":1},{"source":"adminfechassalidapage","t