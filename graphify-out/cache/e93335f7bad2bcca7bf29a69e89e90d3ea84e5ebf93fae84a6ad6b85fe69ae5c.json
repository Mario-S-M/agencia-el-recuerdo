-m/Documents/el-recuerdo/frontend/components/landing/stats-section.tsx","source_location":"L202"}],"snippet":"export function StatsSection() {\n  const sectionRef = useRef<HTMLDivElement>(null);\n  const [activeIndex, setActiveIndex] = useState(0);\n  const stepVh = 58;\n  const totalVh = stats.length * stepVh + 140;\n\n  const { scrollYProgress } = useScroll({\n    target: sectionRef,\n    offset: [\"start start\", \"end end\"],\n  });\n\n  useMotionValueEvent(scrollYProgress, \"change\", (value) => {\n    const next = Math.min(\n      stats.length - 1,\n      Math.floor(value * stats.length)\n    );\n    setActiveIndex((prev) => (prev === next ? prev : next));\n  });\n\n  const activeStat = stats[activeIndex];\n\n  return (\n    <section id=\"nosotros\" className=\"relative bg-[#050A18]\">\n      <div\n        ref={sectionRef}","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"}],"edges":[{"source":"stats_section","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/stats-section.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/stats-section.tsx","source_location":"L3"}],"weight":1},{"source":"stats_section","target":"stats_section_usecountup","relation":"contains","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/stats-section.tsx","source_location":"L82","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/stats-section.tsx","source_location":"L82"}],"weight":1},{"source":"stats_section_usecountup","target":"stats_section_usecountup_step","relation":"contains","confidence