{"__graphifyTsExtractorVersion":61,"nodes":[{"id":"http_client","label":"http-client.ts","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L1"}]},{"id":"http_client_httpclient","label":"HttpClient","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L5-L63","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L5"}],"snippet":"export class HttpClient {\n  constructor(private readonly getToken: () => string | null) {}\n\n  async get<T>(path: string, schema?: z.ZodType): Promise<T> {\n    return this.request<T>('GET', path, undefined, schema);\n  }\n\n  async post<T>(path: string, body?: unknown, schema?: z.ZodType): Promise<T> {\n    return this.request<T>('POST', path, body, schema);\n  }\n\n  async patch<T>(path: string, body?: unknown, schema?: z.ZodType): Promise<T> {\n    return this.request<T>('PATCH', path, body, schema);\n  }\n\n  async delete<T = void>(path: string): Promise<T> {\n    return this.request<T>('DELETE', path);\n  }\n\n  private async request<T>(\n    method: string,\n    path: string,\n    body?: unknown,\n    schema?: z.ZodType,\n  ): Promise<T> {"},{"id":"http_client_httpclient_constructor","label":".constructor()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L6","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L6"}],"snippet":"constructor(private readonly getToken: () => string | null) {}"},{"id":"http_client_httpclient_get","label":".get()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L8-L10","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L8"}],"snippet":"async get<T>(path: string, schema?: z.ZodType): Promise<T> {\n    return this.request<T>('GET', path, undefined, schema);\n  }"},{"id":"http_client_httpclient_post","label":".post()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L12-L14","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L12"}],"snippet":"async post<T>(path: string, body?: unknown, schema?: z.ZodType): Promise<T> {\n    return this.request<T>('POST', path, body, schema);\n  }"},{"id":"http_client_httpclient_patch","label":".patch()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L16-L18","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L16"}],"snippet":"async patch<T>(path: string, body?: unknown, schema?: z.ZodType): Promise<T> {\n    return this.request<T>('PATCH', path, body, schema);\n  }"},{"id":"http_client_httpclient_delete","label":".delete()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L20-L22","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L20"}],"snippet":"async delete<T = void>(path: string): Promise<T> {\n    return this.request<T>('DELETE', path);\n  }"},{"id":"http_client_httpclient_request","label":".request()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L24-L62","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L24"}],"snippet":"private async request<T>(\n    method: string,\n    path: string,\n    body?: unknown,\n    schema?: z.ZodType,\n  ): Promise<T> {\n    const headers: Record<string, string> = { 'Content-Type': 'application/json' };\n    const token = this.getToken();\n    if (token) headers['Authorization'] = `Bearer ${token}`;\n\n    const res = await fetch(`${API}${path}`, {\n      method,\n      headers,\n      body: body !== undefined ? JSON.stringify(body) : undefined,\n    });\n\n    if (res.status === 204) return undefined as T;\n\n    const data: unknown = await res.json();\n\n    if (!res.ok) {\n      const msg =\n        typeof data === 'object' && data !== null && 'message' in data\n          ? String((data as Record<string, unknown>).message)\n          : `Error ${res.status}`;"},{"id":"http_client_gethttpclient","label":"getHttpClient()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L67-L81","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L67"}],"snippet":"export function getHttpClient(): HttpClient {\n  if (!httpClientInstance) {\n    httpClientInstance = new HttpClient(() => {\n      if (typeof window === 'undefined') return null;\n      const raw = localStorage.getItem('auth-storage');\n      if (!raw) return null;\n      try {\n        return (JSON.parse(raw) as { state?: { token?: string } })?.state?.token ?? null;\n      } catch {\n        return null;\n      }\n    });\n  }\n  return httpClientInstance;\n}"}],"edges":[{"source":"http_client","target":"zod","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L1"}],"weight":1},{"source":"http_client","target":"http_client_httpclient","relation":"contains","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L5"}],"weight":1},{"source":"http_client_httpclient","target":"http_client_httpclient_constructor","relation":"method","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L6","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L6"}],"weight":1},{"source":"http_client_httpclient","target":"http_client_httpclient_get","relation":"method","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L8","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/lib/http-client.ts","source_location":"L8"}],"weight":1},{"source":"http