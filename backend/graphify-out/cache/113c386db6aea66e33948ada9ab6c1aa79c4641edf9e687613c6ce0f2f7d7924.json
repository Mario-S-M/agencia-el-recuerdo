   new Date(dto.fechaRegreso) <= new Date(dto.fechaSalida)\n    ) {\n      throw new BadRequestException(\n        'La fecha de regreso debe ser posterior a la fecha de salida',\n      );\n    }\n    if (dto.cupoMinimo > dto.cupoMaximo) {\n      throw new BadRequestException(\n        'El cupo mínimo no puede ser mayor al cupo máximo',\n      );\n    }\n    if (dto.cupoDisponible > dto.cupoMaximo) {\n      throw new BadRequestException(\n        'El cupo disponible no puede ser mayor al cupo máximo',\n      );\n    }\n    return this.fechasSalidaRepository.save({\n      paqueteId: dto.paqueteId,\n      fechaSalida: new Date(dto.fechaSalida),\n      fechaRegreso: dto.fechaRegreso ? new Date(dto.fechaRegreso) : null,\n      cupoMaximo: dto.cupoMaximo,\n      cupoMinimo: dto.cupoMinimo,"},{"id":"fechas_salida_service_fechassalidaservice_update","label":".update()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L82-L125","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L82"}],"snippet":"async update(id: string, dto: UpdateFechaSalidaDto): Promise<FechaSalida> {\n    const existing = await this.findOne(id);\n\n    const fechaSalida = dto.fechaSalida\n      ? new Date(dto.fechaSalida)\n      : existing.fechaSalida;\n    const fechaRegreso = dto.fechaRegreso\n      ? new Date(dto.fechaRegreso)\n      : existing.fechaRegreso;\n\n    if (fechaRegreso && fechaRegreso <= fechaSalida) {\n      throw new BadRequestException(\n        'La fecha de regreso debe ser posterior a la fecha de salida',\n      );\n    }\n\n    const cupoMaximo = dto.cupoMaximo ?? existing.cupoMaximo;\n    const cupoMinimo = dto.cupoMinimo ?? existing.cupoMinimo;\n    const cupoDisponible = dto.cupoDisponible ?? existing.cupoDisponible;\n\n    if (cupoMinimo > cupoMaximo) {\n      throw new BadRequestException(\n        'El cupo mínimo no puede ser mayor al cupo máximo',\n      );\n    }"},{"id":"fechas_salida_service_fechassalidaservice_softdelete","label":".softDelete()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L127-L130","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L127"}],"snippet":"async softDelete(id: string): Promise<void> {\n    await this.findOne(id);\n    await this.fechasSalidaRepository.softDelete(id);\n  }"},{"id":"fechas_salida_service_fechassalidaservice_restore","label":".restore()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L132-L138","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L132"}],"snippet":"async restore(id: string): Promise<FechaSalida> {\n    const fecha = await this.fechasSalidaRepository.findById(id);\n    if (!fecha)\n      throw new NotFoundException(`Fecha de salida con ID ${id} no encontrada`);\n    await this.fechasSalidaRepository.restore(id);\n    return this.findOne(id);\n  }"},{"id":"fechas_salida_service_fechassalidaservice_addopcionhotel","label":".addOpcionHotel()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L142-L154","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L142"}],"snippet":"async addOpcionHotel(\n    fechaSalidaId: string,\n    dto: CreateOpcionHotelDto,\n  ): Promise<OpcionHotel> {\n    await this.findOne(fechaSalidaId);\n    return this.fechasSalidaRepository.saveOpcion({\n      fechaSalidaId,\n      hotelId: dto.hotelId,\n      descripcionHabitacion: dto.descripcionHabitacion ?? null,\n      precio: dto.precio,\n      activo: dto.activo ?? true,\n    });\n  }"},{"id":"fechas_salida_service_fechassalidaservice_updateopcionhotel","label":".updateOpcionHotel()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L156-L168","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L156"}],"snippet":"async updateOpcionHotel(\n    fechaSalidaId: string,\n    opcionId: string,\n    dto: UpdateOpcionHotelDto,\n  ): Promise<OpcionHotel> {\n    const opcion = await this.fechasSalidaRepository.findOpcionById(opcionId);\n    if (!opcion || opcion.fechaSalidaId !== fechaSalidaId) {\n      throw new NotFoundException(\n        `Opción de hotel ${opcionId} no encontrada en la fecha de salida ${fechaSalidaId}`,\n      );\n    }\n    return this.fechasSalidaRepository.updateOpcion(opcionId, { ...dto });\n  }"},{"id":"fechas_salida_service_fechassalidaservice_removeopcionhotel","label":".removeOpcionHotel()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L170-L181","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L170"}],"snippet":"async removeOpcionHotel(\n    fechaSalidaId: string,\n    opcionId: string,\n  ): Promise<void> {\n    const opcion = await this.fechasSalidaRepository.findOpcionById(opcionId);\n    if (!opcion || opcion.fechaSalidaId !== fechaSalidaId) {\n      throw new NotFoundException(\n        `Opción de hotel ${opcionId} no encontrada en la fecha de salida ${fechaSalidaId}`,\n      );\n    }\n    await this.fechasSalidaRepository.deleteOpcion(opcionId);\n  }"},{"id":"fechas_salida_service_fechassalidaservice_addtransporte","label":".addTransporte()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L185-L197","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L185"}],"snippet":"async addTransporte(\n    fechaSalidaId: string,\n    dto: CreateTransporteAdicionalDto,\n  ): Promise<TransporteAdicional> {\n    await this.findOne(fechaSalidaId);\n    return this.fechasSalidaRepository.saveTransporte({\n      fechaSalidaId,\n      descripcion: dto.descripcion,\n      tipoMonto: dto.tipoMonto,\n      monto: dto.monto,\n      activo: dto.activo ?? true,\n    });\n  }"},{"id":"fechas_salida_service_fechassalidaservice_updatetransporte","label":".updateTransporte()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L199-L214","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L199"}],"snippet":"async updateTransporte(\n    fechaSalidaId: string,\n    transporteId: string,\n    dto: UpdateTransporteAdicionalDto,\n  ): Promise<TransporteAdicional> {\n    const transporte =\n      await this.fechasSalidaRepository.findTransporteById(transporteId);\n    if (!transporte || transporte.fechaSalidaId !== fechaSalidaId) {\n      throw new NotFoundException(\n        `Transporte ${transporteId} no encontrado en la fecha de salida ${fechaSalidaId}`,\n      );\n    }\n    return this.fechasSalidaRepository.updateTransporte(transporteId, {\n      ...dto,\n    });\n  }"},{"id":"fechas_salida_service_fechassalidaservice_removetransporte","label":".removeTransporte()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L216-L228","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L216"}],"snippet":"async removeTransporte(\n    fechaSalidaId: string,\n    transporteId: string,\n  ): Promise<void> {\n    const transporte =\n      await this.fechasSalidaRepository.findTransporteById(transporteId);\n    if (!transporte || transporte.fechaSalidaId !== fechaSalidaId) {\n      throw new NotFoundException(\n        `Transporte ${transporteId} no encontrado en la fecha de salida ${fechaSalidaId}`,\n      );\n    }\n    await this.fechasSalidaRepository.deleteTransporte(transporteId);\n  }"}],"edges":[{"source":"fechas_salida_service","target":"common","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fechas-salida.service.ts","source_location":"L1"}],"weight":1},{"source":"fechas_salida_service","target":"fechas_salida","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/fechas-salida/fe