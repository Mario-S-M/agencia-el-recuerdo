etesRepository.save({\n      ...rest,\n      hotelId: dto.hotelId ?? null,\n      servicios,\n      todoIncluido: dto.todoIncluido ?? false,\n      destacado: dto.destacado ?? false,\n      activo: dto.activo ?? true,\n    });\n  }"},{"id":"paquetes_service_paquetesservice_update","label":".update()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/paquetes/paquetes.service.ts","source_location":"L53-L69","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/paquetes/paquetes.service.ts","source_location":"L53"}],"snippet":"async update(id: string, dto: UpdatePaqueteDto): Promise<Paquete> {\n    const paquete = await this.findOne(id);\n    const { servicioIds, ...rest } = dto;\n    let servicios: Servicio[] | undefined;\n    if (servicioIds !== undefined) {\n      const repo = AppDataSource.getRepository(Servicio);\n      servicios =\n        servicioIds.length > 0\n          ? await repo.findBy({ id: In(servicioIds) })\n          : [];\n    }\n    return this.paquetesRepository.update(id, {\n      ...rest,\n      hotelId: dto.hotelId !== undefined ? dto.hotelId : paquete.hotelId,\n      servicios: servicios ?? paquete.servicios,\n    });\n  }"},{"id":"paquetes_service_paquetesservice_softdelete","label":".softDelete()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/paquetes/paquetes.service.ts","source_location":"L71-L74","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/backend/src/paquetes/paquetes.service.ts","source_location":"L71"}],"snippet":"async softDelete(id: string): Promise<void> {\n    await this.findOne(id);\n    await this.paquetesRepository.softDelete(id);\n  }"},{"id":"paquetes_service_paquetesservice_restore","label":".restore()","file_type":"code","source_file":"/User