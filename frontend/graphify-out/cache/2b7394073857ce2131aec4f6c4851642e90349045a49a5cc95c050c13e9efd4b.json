>([]);\n  const [paquetes, setPaquetes] = useState<PaqueteResumen[]>([]);\n  const [isLoading, setIsLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const refresh = useCallback(async (): Promise<void> => {\n    try {\n      setError(null);\n      const [f, p] = await Promise.all([repo.findAll(), repo.getPaquetes()]);\n      setFechas(f);\n      setPaquetes(p);\n    } catch (e) {\n      setError(e instanceof Error ? e.message : 'Error al cargar datos');\n    }\n  }, []);\n\n  useEffect(() => {\n    setIsLoading(true);\n    refresh().finally(() => setIsLoading(false));\n  }, [refresh]);\n\n  async function create(input: CreateFechaSalidaInput): Promise<void> {\n    const fecha = await repo.create(input);\n    setFechas((prev) => [...prev, fecha]);","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"usefechassalida_usefechassalida_create","label":"create()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/hooks/useFechasSalida.ts","source_location":"L42-L45","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/hooks/useFechasSalida.ts","source_location":"L42"}],"snippet":"async function create(input: CreateFechaSalidaInput): Promise<void> {\n    const fecha = await repo.create(input);\n    setFechas((prev) => [...prev, fecha]);\n  }"},{"id":"usefechassalida_usefechassalida_update","label":"update()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/presentation/hooks/useFechasSalida.ts","source_location":"L47-L50","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/fechas-salida/pr