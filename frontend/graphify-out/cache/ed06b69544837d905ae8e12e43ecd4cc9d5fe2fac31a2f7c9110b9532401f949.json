);\n    };","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"hero_section_herosection_handlemousemove","label":"handleMouseMove()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/hero-section.tsx","source_location":"L57-L63","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/hero-section.tsx","source_location":"L57"}],"snippet":"handleMouseMove = (e: MouseEvent) => {\n      const { left, top, width, height } = el.getBoundingClientRect();\n      const x = ((e.clientX - left) / width - 0.5) * 20;\n      const y = ((e.clientY - top) / height - 0.5) * 20;\n      el.style.setProperty(\"--mouse-x\", `${x}px`);\n      el.style.setProperty(\"--mouse-y\", `${y}px`);\n    }"}],"edges":[{"source":"hero_section","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/hero-section.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/hero-section.tsx","source_location":"L3"}],"weight":1},{"source":"hero_section","target":"globe","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/hero-section.tsx","source_location":"L5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/landing/hero-section.tsx","source_location":"L5"}],"weight":1},{"source":"hero_section","target":"aurora_text","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/fronten