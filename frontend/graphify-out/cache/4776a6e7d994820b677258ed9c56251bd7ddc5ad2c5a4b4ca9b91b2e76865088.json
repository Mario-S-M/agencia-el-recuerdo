5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/destinos/presentation/components/client/MediaUploader.tsx","source_location":"L59"}],"snippet":"async function handleFiles(files: FileList): Promise<void> {\n    setError(null);\n    const items: UploadingItem[] = Array.from(files).map((f) => ({\n      id: crypto.randomUUID(),\n      name: f.name,\n    }));\n    setUploading((prev) => [...prev, ...items]);\n\n    const results = await Promise.allSettled(\n      Array.from(files).map((file, i) =>\n        uploadMedia(file, token ?? '').then((r) => ({ id: items[i].id, url: r.url })),\n      ),\n    );\n\n    const succeeded: string[] = [];\n    const failedNames: string[] = [];\n    let firstError: string | null = null;\n\n    results.forEach((r, i) => {\n      if (r.status === 'fulfilled') {\n        succeeded.push(r.value.url);\n      } else {\n        failedNames.push(items[i].name);\n        if (!firstError) {\n          const msg = r.reason instanceof Error ? r.reason.message : String(r.reason);"},{"id":"mediauploader_mediauploader_handlechange","label":"handleChange()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/destinos/presentation/components/client/MediaUploader.tsx","source_location":"L97-L100","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/destinos/presentation/components/client/MediaUploader.tsx","source_location":"L97"}],"snippet":"function handleChange(e: React.ChangeEvent<HTMLInputElement>): void {\n    if (e.target.files?.length) void handleFiles(e.target.files);\n    e.target.value = '';\n  }"},{"id":"mediauploader_mediauploader_handledrop","label":"handleDrop()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/destinos/prese