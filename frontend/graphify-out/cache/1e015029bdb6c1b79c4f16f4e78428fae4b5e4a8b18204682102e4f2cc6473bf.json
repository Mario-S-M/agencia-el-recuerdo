","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/ui/morphing-text.tsx","source_location":"L59-L74","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/ui/morphing-text.tsx","source_location":"L59"}],"snippet":"animate = (now: number) => {\n      const dt = (now - lastTime) / 1000\n      lastTime = now\n      timeRef.current = requestAnimationFrame(animate)\n\n      cooldownRef.current -= dt\n\n      if (cooldownRef.current <= 0) {\n        if (morphRef.current === 0) {\n          textIndexRef.current++\n        }\n        doMorph()\n      } else {\n        doCooldown()\n      }\n    }"},{"id":"morphing_text_morphingtextprops","label":"MorphingTextProps","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/ui/morphing-text.tsx","source_location":"L85-L88","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/ui/morphing-text.tsx","source_location":"L85"}],"snippet":"interface MorphingTextProps {\n  className?: string\n  texts: string[]\n}"},{"id":"morphing_text_morphingtext","label":"MorphingText()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/ui/morphing-text.tsx","source_location":"L90-L126","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/components/ui/morphing-text.tsx","source_location":"L90"}],"snippet":"export function MorphingText({ texts, className }: MorphingTextProps) {\n  const { text1Ref, text2Ref } = useMorphingText(texts)\n\n  return (\n    <div\n      className={cn(\n        \"relative flex h-16 w-full items-center justify-center\",\n        className,\n      )}\n    >\n      <sv