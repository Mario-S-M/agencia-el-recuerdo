{"__graphifyTsExtractorVersion":61,"nodes":[{"id":"chat_api","label":"chat.api.ts","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/chat/data/api/chat.api.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/chat/data/api/chat.api.ts","source_location":"L1"}]},{"id":"chat_api_extracttextfromresponse","label":"extractTextFromResponse()","file_type":"code","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/chat/data/api/chat.api.ts","source_location":"L6-L21","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/chat/data/api/chat.api.ts","source_location":"L6"}],"snippet":"function extractTextFromResponse(data: unknown): string {\n  const parsed = n8nResponseSchema.safeParse(data);\n\n  if (!parsed.success) {\n    console.error('[ChatApi] Zod validation failed for n8n response:', parsed.error.format());\n    return 'Lo siento, hubo un error al procesar la respuesta. Por favor intenta de nuevo.';\n  }\n\n  const response: N8nResponseDTO = parsed.data;\n  if ('output' in response) return response.output;\n  if ('message' in response) return response.message;\n  if ('text' in response) return response.text;\n  if ('response' in response) return response.response;\n\n  return 'Lo siento, no pude entender la respuesta. Por favor intenta de nuevo.';\n}"}],"edges":[{"source":"chat_api","target":"chat","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/chat/data/api/chat.api.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/chat/data/api/chat.api