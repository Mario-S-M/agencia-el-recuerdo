lendarioRepository.getActivas();\n      setFechas(data);\n    } catch (err) {\n      const message =\n        err instanceof Error ? err.message : 'Error desconocido';\n      setError(message);\n    } finally {\n      setIsLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    void fetchFechas();\n  }, [fetchFechas]);\n\n  return { fechas, isLoading, error, refetch: fetchFechas };","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"}],"edges":[{"source":"usecalendario","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/calendario/presentation/hooks/useCalendario.ts","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/calendario/presentation/hooks/useCalendario.ts","source_location":"L3"}],"weight":1},{"source":"usecalendario","target":"calendario","relation":"imports_from","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/calendario/presentation/hooks/useCalendario.ts","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/calendario/presentation/hooks/useCalendario.ts","source_location":"L4"}],"weight":1},{"source":"usecalendario","target":"usecalendario_usecalendarioreturn","relation":"contains","confidence":"EXTRACTED","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/calendario/presentation/hooks/useCalendario.ts","source_location":"L9","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"/Users/mario-e-s-m/Documents/el-recuerdo/frontend/features/calendario/presentation/hooks/useCalendario.ts","source_location":"